# Copy to .env.local and fill in real values. .env.local is gitignored and never committed.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Phase 2 -- Storefront API cart sync (lib/shopify/storefront.ts, lib/shopify/cart-sync.ts).
# This is a SEPARATE token from SHOPIFY_CLIENT_ID/SECRET above -- it has no Admin API access.
# Create it in Shopify Admin: Settings -> Apps and sales channels -> Develop apps -> (this app)
# -> API credentials -> "Storefront API" -> Configure, then enable at least:
#   unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
#   unauthenticated_write_checkouts (cart read/write lives under the checkout scopes)
# Shopify then shows a "Storefront API access token" -- paste it below. This token is meant to be
# public/embeddable per Shopify's own docs, but we still only ever use it server-side here, same
# as every other Shopify/Supabase credential in this codebase.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Only needed if the Storefront API should hit a different domain than SHOPIFY_STORE_DOMAIN.
SHOPIFY_STOREFRONT_DOMAIN=

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Phase 5 -- Stripe is the only payment provider, LIVE mode (not test keys).
# Add the real values via this environment's own secrets/variables settings, never in chat.
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Order confirmation email
RESEND_API_KEY=

# Checkout stays off (non-public) until explicitly flipped on -- see docs/phase4-verification-report.md
NEXT_PUBLIC_CHECKOUT_ENABLED=false
