# Copy to .env.local and fill in real values. .env.local is gitignored and never committed.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Order confirmation email
RESEND_API_KEY=

# Stripe has been removed. Checkout stays off until the Shopify-backed checkout replaces it.
NEXT_PUBLIC_CHECKOUT_ENABLED=false
